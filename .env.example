# Cashflow Genius — Vercel env vars (copy to .env.local for local dev;
# set the same values in Vercel → Project Settings → Environment Variables)

# Supabase Postgres (Session Pooler, port 6543) — REQUIRED for all data.
# Supabase dashboard → Project Settings → Database → Connection string
# (choose "Session pooler"), then append ?sslmode=require if missing.
# Format: postgresql://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Auth (public client values — safe to expose; already defaulted
# in code to the Cashflow Genius project, set these only to override).
NEXT_PUBLIC_SUPABASE_URL=https://zfngqppwmyizlnrzhrjc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6D9rlSGsbPzqkMVyWdrZ3w_60JseEvy

# Gemini AI (free tier, Google AI Studio) — OPTIONAL. Enables the AI CFO
# and daily briefing via Gemini. Without it the AI CFO answers with the
# honest rule-based fallback and the app says so. A per-account key saved
# in Settings is used first when present.
GEMINI_API_KEY=
